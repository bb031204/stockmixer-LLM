{"schema_version": "stockmixer_source_adapter_v1", "source_schema_version": "public-title-11", "source_id": "53cf2d36bfe3c47fc6688ea0", "title": "The Long, Agonizing Fall of PacSun", "summary": "Pacific Sunwear of California Inc. filed for bankruptcy protection from creditors on Thursday, hoping a restructuring could help turn around the 36-year-old surf retailer's fortunes. The company's shares are down 96 percent over the past 12 months.", "language": "en", "language_basis": "matching_current_audit", "market": "US", "impact_scope": ["company"], "record_version": "ddec630d56c3c6e6d3050a8ce7f4e344e82de1e4b011c3f90b650c6337499158", "source_record_hash": "ddec630d56c3c6e6d3050a8ce7f4e344e82de1e4b011c3f90b650c6337499158", "qwen_model_name": "qwen3:8b", "qwen_model_revision": "500a1f067a9f782620b40bee6f7b0c89e17ae61f686b92c24933e4ca4b2b8b41", "prompt_version": "6eafca44da0cb62e297f0e0004f2866baae41652da30e359d433d16c1550b5c2", "producer_code_version": "fa7dec9f661c5d2629b81abac7ab099bec75cd39643ba856ba6671e431d8cffd", "producer_schema_version": "1.1", "analysis_method": null, "source_verification": "not_revalidated_by_adapter", "availability_comparison": "strictly_before_cutoff", "entities": [{"名称": "Pacific Sunwear of California Inc.", "股票代码": null, "交易所": null}], "industries": [{"名称": "Fashion", "依据": "explicit"}], "events": [{"event_type": "corporate_action", "subject": null, "action": null, "object": "creditors", "key_period": null, "key_values": null, "conditions": null, "evidence_type": "explicit", "quote": "Pacific Sunwear of California Inc. filed for bankruptcy protection from creditors on Thursday"}], "industry_impacts": [], "security_mapping_status": "unresolved", "historical_industry_mapping_status": "unresolved", "producer_quality_flags": ["event_argument_omitted"], "adapter_schema_version": "stockmixer_source_adapter_v1", "published_at": "2016-04-08", "publication_precision": "date", "first_seen_at": "2026-11-11T05:09:43.483765+00:00", "fetched_at": "2026-1