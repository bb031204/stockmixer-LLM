{"schema_version": "stockmixer_source_adapter_v1", "source_schema_version": "public-title-11", "source_id": "51f3924dd7586ad38d384929", "title": "American Apparel Seeks Bankruptcy Protection a Second Time", "summary": "American Apparel Inc., the clothing brand built on racy advertising and made-in-the-U.S.A. marketing, is back in bankruptcy after nine months and may emerge as a Canadian concern. The Los-Angeles based company filed for Chapter 11 protection Monday, with plans to sell itself at auction with a lead bid of $66 million from Canadian T-shirt and underwear maker Gildan Activewear Inc. Montreal-based Gildan said in a statement that it wants to buy the brand and inventory supply, but not any stores.", "language": "en", "language_basis": "matching_current_audit", "market": "US", "impact_scope": ["company", "industry"], "record_version": "f93e5fc5a963d292cc908513f2a4e32377f1d857d4128982b5d868cf2d8885ef", "source_record_hash": "f93e5fc5a963d292cc908513f2a4e32377f1d857d4128982b5d868cf2d8885ef", "qwen_model_name": "qwen3:8b", "qwen_model_revision": "500a1f067a9f782620b40bee6f7b0c89e17ae61f686b92c24933e4ca4b2b8b41", "prompt_version": "6eafca44da0cb62e297f0e0004f2866baae41652da30e359d433d16c1550b5c2", "producer_code_version": "fa7dec9f661c5d2629b81abac7ab099bec75cd39643ba856ba6671e431d8cffd", "producer_schema_version": "1.1", "analysis_method": null, "source_verification": "not_revalidated_by_adapter", "availability_comparison": "strictly_before_cutoff", "entities": [{"名称": "American Apparel Inc.", "股票代码": null, "交易所": null}, {"名称": "Gildan Activewear Inc.", "股票代码": null, "交易所": null}], "industries": [{"名称": "Apparel", "依据": "explicit"}], "events": [], "industry_impacts": [], "security_mapping_status": "unresolved", "historical_industry_mapping_status": "unresolved", "producer_quality_flags": [], "adapter_schema_version": "stockmixer_source_adapter_v1", "published_at": "2016-11-14T06:47:32.434000+00:00", "publication_precision": "second", "first_seen_at": "2026-11-