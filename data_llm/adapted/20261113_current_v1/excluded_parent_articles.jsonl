{"schema_version": "stockmixer_source_adapter_v1", "source_schema_version": "public-title-11", "source_id": "544328b63d225e6528ab0539", "title": "Perrigo Company plc Completes Acquisition Of Omega Pharma Invest N.V., Creating A Top Five Global OTC Company", "summary": "Perrigo Company plc completed the acquisition of Omega Pharma Invest N.V. in a cash and equity transaction valued at approximately €3.8 billion, including €1.3 billion in debt. The acquisition creates a top 5 global OTC healthcare company by revenue. The transaction is expected to be immediately accretive, with fiscal 2016 adjusted earnings per share between $0.10 and $0.20 after adjusting for amortization, transaction, and financing costs. Omega generated approximately €1.27 billion of revenue and €200 million of operating cash flow in the year ended December 31, 2014. The Company expects to achieve increasing revenue and supply chain synergies in Europe, contributing greater than $125 million to gross profit in 2019. Securities explicitly mentioned in the source include Perrigo Company plc (PRGO).", "language": "en", "language_basis": "matching_current_audit", "market": "US", "impact_scope": ["company", "industry", "market"], "record_version": "59eac106a532cee746fa30837b29859a36dd533c979a73620a16d69624fa550b", "source_record_hash": "59eac106a532cee746fa30837b29859a36dd533c979a73620a16d69624fa550b", "qwen_model_name": "qwen3:8b", "qwen_model_revision": "500a1f067a9f782620b40bee6f7b0c89e17ae61f686b92c24933e4ca4b2b8b41", "prompt_version": "6eafca44da0cb62e297f0e0004f2866baae41652da30e359d433d16c1550b5c2", "producer_code_version": "fa7dec9f661c5d2629b81abac7ab099bec75cd39643ba856ba6671e431d8cffd", "producer_schema_version": "1.1", "analysis_method": null, "source_verification": "not_revalidated_by_adapter", "availability_comparison": "strictly_before_cutoff", "entities": [{"名称": "Perrigo Company plc", "股票代码": "PRGO", "交易所": "NYSE"}], "industries": [{"名称": "Pharmaceuticals", "依据": "inferred"}], "events":