{"schema_version": "stockmixer_source_adapter_v1", "source_schema_version": "public-title-11", "source_id": "ecd4ec5dfb37ac3f73d1c55a", "title": "Pacific Andes Enters Bankruptcy Blaming El Nino, Lender Acts", "summary": "Pacific Andes Group, the world’s 12th-largest seafood company, filed for bankruptcy in New York after investigations by Singapore and Hong Kong market regulators and pressure by lenders to start a fire-sale. The company’s liquidity crisis was triggered by the El Nino weather pattern and the depleted Peruvian anchovy stocks that resulted, as well as 'aggressive and improper acts by certain lenders,' Chief Executive Officer Ng Puay Yee said in court filings. While 16 units filed for court protection, others aren’t in bankruptcy, according to the filings, which listed $4.7 billion in assets and $2.5 billion in debt as of March 28, 2015.", "language": "en", "language_basis": "matching_current_audit", "market": "US", "impact_scope": ["company", "industry"], "record_version": "6c3d4188dd29d06f544524f48c4bb7e932ffb37e2d06a97ce17e9e58f2db2c09", "source_record_hash": "6c3d4188dd29d06f544524f48c4bb7e932ffb37e2d06a97ce17e9e58f2db2c09", "qwen_model_name": "qwen3:8b", "qwen_model_revision": "500a1f067a9f782620b40bee6f7b0c89e17ae61f686b92c24933e4ca4b2b8b41", "prompt_version": "6eafca44da0cb62e297f0e0004f2866baae41652da30e359d433d16c1550b5c2", "producer_code_version": "fa7dec9f661c5d2629b81abac7ab099bec75cd39643ba856ba6671e431d8cffd", "producer_schema_version": "1.1", "analysis_method": null, "source_verification": "not_revalidated_by_adapter", "availability_comparison": "strictly_before_cutoff", "entities": [{"名称": "Pacific Andes Group", "股票代码": null, "交易所": null}], "industries": [{"名称": "Seafood", "依据": "explicit"}], "events": [], "industry_impacts": [], "security_mapping_status": "unresolved", "historical_industry_mapping_status": "unresolved", "producer_quality_flags": ["event_unverified", "industry_impact_unverified"], "adapter_schema_version": "stockmixer_so