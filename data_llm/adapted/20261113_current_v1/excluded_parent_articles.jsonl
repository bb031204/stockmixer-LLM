{"schema_version": "stockmixer_source_adapter_v1", "source_schema_version": "public-title-11", "source_id": "5411f33d3aced1e3e47ec206", "title": "5 Big-Name Bankruptcies of 2012", "summary": "Hostess Brands, Kodak, and American Suzuki Motor Corporation filed for bankruptcy protection in 2012. Kodak sought Chapter 11 reorganization to repay debts, with an $830 million agreement approved, pending sale of its digital imaging patents. American Suzuki planned to realign its business by ceasing new car sales and focusing on parts and motorcycle/ATV/marine divisions.", "language": "en", "language_basis": "matching_current_audit", "market": "US", "impact_scope": ["company", "industry"], "record_version": "cb51de67bb77201a387ecfedc8b5c8cd3f14b4a59cce4254b6bea189f4c193a4", "source_record_hash": "cb51de67bb77201a387ecfedc8b5c8cd3f14b4a59cce4254b6bea189f4c193a4", "qwen_model_name": "qwen3:8b", "qwen_model_revision": "500a1f067a9f782620b40bee6f7b0c89e17ae61f686b92c24933e4ca4b2b8b41", "prompt_version": "6eafca44da0cb62e297f0e0004f2866baae41652da30e359d433d16c1550b5c2", "producer_code_version": "fa7dec9f661c5d2629b81abac7ab099bec75cd39643ba856ba6671e431d8cffd", "producer_schema_version": "1.1", "analysis_method": null, "source_verification": "not_revalidated_by_adapter", "availability_comparison": "strictly_before_cutoff", "entities": [{"名称": "Hostess Brands", "股票代码": null, "交易所": null}, {"名称": "Eastman Kodak Company", "股票代码": null, "交易所": null}, {"名称": "American Suzuki Motor Corporation", "股票代码": null, "交易所": null}], "industries": [{"名称": "Consumer Goods", "依据": "inferred"}], "events": [], "industry_impacts": [], "security_mapping_status": "unresolved", "historical_industry_mapping_status": "unresolved", "producer_quality_flags": [], "adapter_schema_version": "stockmixer_source_adapter_v1", "published_at": "2013-02-27T05:16:08+00:00", "publication_precision": "second", "first_seen_at": "2026-11-11T05:09:20.143586+00:00", "fetched_at": "2026-11-12T18:17:18.807604+00:00", "llm_infe