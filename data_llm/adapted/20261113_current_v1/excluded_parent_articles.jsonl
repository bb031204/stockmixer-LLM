{"schema_version": "stockmixer_source_adapter_v1", "source_schema_version": "public-title-11", "source_id": "cd7c78fbf8b833435c76946f", "title": "Ultra Petroleum Files for Bankruptcy, Citing $3.9 Billion Debt", "summary": "Ultra Petroleum Corp. filed for bankruptcy protection, the latest oil and gas explorer to fall victim to the prolonged slump in energy prices. The Houston-based company listed $1.3 billion in assets and $3.9 billion in debt in court papers filed in Houston on Friday.", "language": "en", "language_basis": "matching_current_audit", "market": "US", "impact_scope": ["company"], "record_version": "90bb98d4e6073aca1dd0bc5fc65aa1002fb25f2bb388b89082713d2ef6d27bd7", "source_record_hash": "90bb98d4e6073aca1dd0bc5fc65aa1002fb25f2bb388b89082713d2ef6d27bd7", "qwen_model_name": "qwen3:8b", "qwen_model_revision": "500a1f067a9f782620b40bee6f7b0c89e17ae61f686b92c24933e4ca4b2b8b41", "prompt_version": "6eafca44da0cb62e297f0e0004f2866baae41652da30e359d433d16c1550b5c2", "producer_code_version": "fa7dec9f661c5d2629b81abac7ab099bec75cd39643ba856ba6671e431d8cffd", "producer_schema_version": "1.1", "analysis_method": null, "source_verification": "not_revalidated_by_adapter", "availability_comparison": "strictly_before_cutoff", "entities": [{"名称": "Ultra Petroleum Corp.", "股票代码": null, "交易所": null}], "industries": [{"名称": "Oil and Gas", "依据": "explicit"}], "events": [{"event_type": "corporate_action", "subject": null, "action": "bankruptcy", "object": "Ultra Petroleum Corp.", "key_period": null, "key_values": null, "conditions": null, "evidence_type": "explicit", "quote": "Ultra Petroleum Corp. filed for bankruptcy protection"}], "industry_impacts": [], "security_mapping_status": "unresolved", "historical_industry_mapping_status": "unresolved", "producer_quality_flags": ["event_argument_omitted"], "adapter_schema_version": "stockmixer_source_adapter_v1", "published_at": "2016-05-01T19:37:38.999000+00:00", "publication_precision": "second", "first_seen_at": "2026-11-11T05: